BIND_ADDRESS=127.0.0.1
API_PORT=8000
MLFLOW_PORT=5000
AIRFLOW_PORT=8080

MODEL_PACKAGE_DIR=./artifacts/model-package

# Пароль Postgres используется внутри URI
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# AIRFLOW_FERNET_KEY — urlsafe-base64 от 32 случайных байт
# AIRFLOW_JWT_SECRET — произвольная строка
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=

# Настройки приложения для локального запуска без Docker
TEXT_CLF_ENVIRONMENT=development
TEXT_CLF_API__HOST=0.0.0.0
TEXT_CLF_API__PORT=8000
TEXT_CLF_API__MIN_TEXT_LENGTH=2
TEXT_CLF_API__MAX_TEXT_LENGTH=1500
TEXT_CLF_API__MAX_TOP_K=10
TEXT_CLF_API__MAX_CONCURRENCY=4
TEXT_CLF_API__SHUTDOWN_TIMEOUT_SECONDS=20

TEXT_CLF_MODEL__SOURCE=local
TEXT_CLF_MODEL__URI=artifacts/model-package
TEXT_CLF_MODEL__DEVICE=auto
TEXT_CLF_MODEL__LOCAL_FILES_ONLY=true
TEXT_CLF_MODEL__REGISTRY_CACHE_DIR=/tmp/text-clf-model-cache
TEXT_CLF_MODEL__REGISTRY_DOWNLOAD_ATTEMPTS=3

TEXT_CLF_MLFLOW__EXPERIMENT_NAME=banking77-classification
TEXT_CLF_MLFLOW__REGISTERED_MODEL_NAME=banking77-intent-classifier
TEXT_CLF_MLFLOW__CANDIDATE_ALIAS=candidate
TEXT_CLF_MLFLOW__CHAMPION_ALIAS=champion

TEXT_CLF_OBSERVABILITY__LOG_LEVEL=INFO
TEXT_CLF_OBSERVABILITY__JSON_LOGS=true
